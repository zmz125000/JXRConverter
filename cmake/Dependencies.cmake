jxrc_source(jpegxr_src https://github.com/bvibber/jpegxr.git 0.3.1)
set(jxr "${jpegxr_src_SOURCE_DIR}/jxrlib")
file(GLOB jxr_sources "${jxr}/image/sys/*.c" "${jxr}/image/decode/*.c" "${jxr}/image/encode/*.c" "${jxr}/jxrgluelib/*.c")
list(FILTER jxr_sources EXCLUDE REGEX "(perfTimer[^/]*|JXRGluePFC[^/]*|JXRGlueJxr[^/]*)\\.c$")
# The packaging contains only ANSI and Windows performance timer alternatives.
list(APPEND jxr_sources "${jxr}/image/sys/perfTimerANSI.c" "${jxr}/jxrgluelib/JXRGluePFC.c" "${jxr}/jxrgluelib/JXRGlueJxr.c")
add_library(jxrc_jxr STATIC ${jxr_sources})
target_include_directories(jxrc_jxr PUBLIC "${jxr}" "${jxr}/common/include" "${jxr}/image/sys" "${jxr}/jxrgluelib")
target_compile_definitions(jxrc_jxr PUBLIC __ANSI__ DISABLE_PERF_MEASUREMENT)
