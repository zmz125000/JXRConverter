include(FetchContent)
include(ExternalProject)
find_package(Git REQUIRED)
file(WRITE "${PROJECT_BINARY_DIR}/dependency-sources.tsv" "")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
# Reuse already downloaded LocalViewer _deps sources without requiring Android.
set(JXRC_DEPS_DIR "" CACHE PATH "Optional populated LocalViewer native _deps directory")
function(jxrc_source name repository tag)
    string(TOUPPER "${name}" upper)
    if(JXRC_DEPS_DIR AND EXISTS "${JXRC_DEPS_DIR}/${name}-src")
        set(candidate "${JXRC_DEPS_DIR}/${name}-src")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${candidate}" rev-parse --verify HEAD
            OUTPUT_VARIABLE cached_head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${candidate}" rev-parse --verify "refs/tags/${tag}^{commit}"
            OUTPUT_VARIABLE release_head RESULT_VARIABLE release_found OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(release_found EQUAL 0 AND cached_head STREQUAL release_head)
            set(FETCHCONTENT_SOURCE_DIR_${upper} "${candidate}")
        else()
            message(STATUS "Ignoring ${name} cache: it does not match release ${tag}")
            if("${FETCHCONTENT_SOURCE_DIR_${upper}}" STREQUAL "${candidate}")
                set(FETCHCONTENT_SOURCE_DIR_${upper} "" CACHE PATH "Source override" FORCE)
                set(FETCHCONTENT_SOURCE_DIR_${upper} "")
            endif()
        endif()
    endif()
    # A source-only population lets us configure upstream options before add_subdirectory.
    if(POLICY CMP0169)
        cmake_policy(SET CMP0169 OLD)
    endif()
    if(name STREQUAL "libjxl")
        FetchContent_Declare(${name} GIT_REPOSITORY ${repository} GIT_TAG ${tag} GIT_SHALLOW TRUE
            GIT_SUBMODULES third_party/brotli third_party/highway third_party/skcms)
    elseif(name STREQUAL "stb")
        FetchContent_Declare(${name} GIT_REPOSITORY ${repository} GIT_TAG ${tag} GIT_SHALLOW FALSE)
    else()
        FetchContent_Declare(${name} GIT_REPOSITORY ${repository} GIT_TAG ${tag} GIT_SHALLOW TRUE)
    endif()
    FetchContent_GetProperties(${name})
    if(NOT ${name}_POPULATED)
        FetchContent_Populate(${name})
    endif()
    file(APPEND "${PROJECT_BINARY_DIR}/dependency-sources.tsv" "${name}\t${${name}_SOURCE_DIR}\t${repository}\t${tag}\n")
    set(${name}_SOURCE_DIR "${${name}_SOURCE_DIR}" PARENT_SCOPE)
    set(${name}_BINARY_DIR "${${name}_BINARY_DIR}" PARENT_SCOPE)
endfunction()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
# Build JPEG once; both Ultra HDR and LibRaw use these headers and symbols.
jxrc_source(libultrahdr https://github.com/google/libultrahdr.git v2.0.2)
set(ENABLE_SHARED OFF CACHE BOOL "" FORCE)
set(ENABLE_STATIC ON CACHE BOOL "" FORCE)
set(WITH_TURBOJPEG OFF CACHE BOOL "" FORCE)
jxrc_source(jpeg https://github.com/libjpeg-turbo/libjpeg-turbo.git 3.2.1)
set(jpeg_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/jpeg")
set(jxrc_jpeg_name "${CMAKE_STATIC_LIBRARY_PREFIX}jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}")
if(MSVC)
    set(jxrc_jpeg_name jpeg-static.lib)
endif()
set(jxrc_jpeg_file "${jpeg_BINARY_DIR}/${jxrc_jpeg_name}")
if(CMAKE_CONFIGURATION_TYPES)
    set(jxrc_jpeg_file "${jpeg_BINARY_DIR}/$<CONFIG>/${jxrc_jpeg_name}")
endif()
ExternalProject_Add(jxrc_jpeg_build SOURCE_DIR "${jpeg_SOURCE_DIR}" BINARY_DIR "${jpeg_BINARY_DIR}"
    DOWNLOAD_COMMAND "" UPDATE_COMMAND "" INSTALL_COMMAND ""
    CMAKE_ARGS -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DENABLE_SHARED=OFF -DENABLE_STATIC=ON
        -DWITH_TURBOJPEG=OFF -DWITH_CRT_DLL=ON -DCMAKE_POSITION_INDEPENDENT_CODE=ON
        -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER} -DCMAKE_INSTALL_PREFIX=${CMAKE_BINARY_DIR}/unused
    BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --config $<CONFIG> --target jpeg-static
    BUILD_BYPRODUCTS "${jxrc_jpeg_file}")
add_library(jpeg-static STATIC IMPORTED GLOBAL)
set_target_properties(jpeg-static PROPERTIES IMPORTED_LOCATION "${jxrc_jpeg_file}")
foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
    string(TOUPPER "${config}" config_upper)
    set_property(TARGET jpeg-static PROPERTY IMPORTED_LOCATION_${config_upper} "${jpeg_BINARY_DIR}/${config}/${jxrc_jpeg_name}")
endforeach()
add_dependencies(jpeg-static jxrc_jpeg_build)
set(JPEG_LIBRARY jpeg-static CACHE STRING "" FORCE)
set(JPEG_INCLUDE_DIR "${jpeg_SOURCE_DIR}/src" CACHE PATH "" FORCE)
set(JPEG_INCLUDE_DIRS "${jpeg_SOURCE_DIR}/src;${jpeg_BINARY_DIR}")
# FindJPEG's imported target needs an actual path; native targets link jpeg-static directly.
set(UHDR_BUILD_DEPS OFF CACHE BOOL "" FORCE)
foreach(flag EXAMPLES TESTS BENCHMARK FUZZERS JAVA)
    set(UHDR_BUILD_${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(UHDR_ENABLE_HEIF OFF CACHE BOOL "" FORCE)
set(UHDR_ENABLE_GLES OFF CACHE BOOL "" FORCE)
set(UHDR_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(UHDR_WRITE_XMP ON CACHE BOOL "" FORCE)
set(UHDR_WRITE_ISO ON CACHE BOOL "" FORCE)
add_subdirectory("${libultrahdr_SOURCE_DIR}" "${libultrahdr_BINARY_DIR}" EXCLUDE_FROM_ALL)
# Link the ordinary core archive and its CMake dependencies, not the repacked
# uhdr/uhdr-static archive. Repacking imported JPEG archives nests .a files on
# macOS, and the wrapper target also has a different name on MSVC.
add_library(jxrc_uhdr INTERFACE)
target_link_libraries(jxrc_uhdr INTERFACE core)
if(MSVC)
    set_property(TARGET core image_io PROPERTY MSVC_RUNTIME_LIBRARY "${CMAKE_MSVC_RUNTIME_LIBRARY}")
endif()
target_include_directories(core PRIVATE "${jpeg_BINARY_DIR}")
add_dependencies(core jxrc_jpeg_build)
# Ultra HDR 2.0.2 has no public CPU-budget setting. Adapt its CPU-count helper
# in a build-tree copy, so concurrent GUI jobs share the same per-call budget.
file(READ "${libultrahdr_SOURCE_DIR}/lib/src/jpegr.cpp" jxrc_uhdr_source)
set(jxrc_uhdr_cpu "unsigned int GetCPUCoreCount() { return (std::max)(1u, std::thread::hardware_concurrency()); }")
string(REPLACE "${jxrc_uhdr_cpu}" "unsigned int GetCPUCoreCount() { return jxrc_limit_threads((std::max)(1u, std::thread::hardware_concurrency())); }" jxrc_uhdr_patched "${jxrc_uhdr_source}")
if(jxrc_uhdr_patched STREQUAL jxrc_uhdr_source)
    message(FATAL_ERROR "Ultra HDR CPU-budget adaptation no longer matches the pinned source")
endif()
set(jxrc_uhdr_patched "#include \"${CMAKE_CURRENT_LIST_DIR}/../src/native/hdr_parallel.h\"\n${jxrc_uhdr_patched}")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/jxrc_uhdr_jpegr.cpp" CONTENT "${jxrc_uhdr_patched}" @ONLY)
get_target_property(jxrc_uhdr_objects core SOURCES)
list(REMOVE_ITEM jxrc_uhdr_objects "${libultrahdr_SOURCE_DIR}/lib/src/jpegr.cpp")
set_property(TARGET core PROPERTY SOURCES "${jxrc_uhdr_objects};${CMAKE_CURRENT_BINARY_DIR}/jxrc_uhdr_jpegr.cpp")


