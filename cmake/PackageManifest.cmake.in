set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    # An app-only installation uses paths relative to the app bundle itself.
    set(app "${root}/jxrconverter.app")
    set(app_manifest "Contents/Resources/share/JXRConverter/package-files.txt")
    file(GLOB_RECURSE app_entries RELATIVE "${app}" LIST_DIRECTORIES FALSE "${app}/*")
    list(APPEND app_entries "${app_manifest}" "Contents/_CodeSignature/CodeResources")
    list(REMOVE_DUPLICATES app_entries)
    list(SORT app_entries)
    string(REPLACE ";" "\n" listing "${app_entries}")
    file(WRITE "${app}/${app_manifest}" "${listing}\n")
    # All resources and the helper are installed now. Seal the final bundle,
    # including the license texts and its internal update manifest.
    execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${app}" RESULT_VARIABLE signed)
    if(NOT signed EQUAL 0)
        message(FATAL_ERROR "Could not sign the complete macOS application")
    endif()
endif()
set(manifest "@CMAKE_INSTALL_DATADIR@/JXRConverter/package-files.txt")
file(GLOB_RECURSE entries RELATIVE "${root}" LIST_DIRECTORIES FALSE "${root}/*")
list(APPEND entries "${manifest}")
list(REMOVE_DUPLICATES entries)
list(SORT entries)
string(REPLACE ";" "\n" listing "${entries}")
file(WRITE "${root}/${manifest}" "${listing}\n")
