# libaom's append_flag() forces directory-local compiler flags into the global
# cache. Preserve the caller's flags and move libaom's additions to its targets.
get_cmake_property(jxrc_cache_variables CACHE_VARIABLES)
function(jxrc_aom_compile_option directory option)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
            target_compile_options(${target} PRIVATE "${option}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        jxrc_aom_compile_option("${child}" "${option}")
    endforeach()
endfunction()
set(jxrc_saved_flag_names "")
foreach(name IN LISTS jxrc_cache_variables)
    if(name MATCHES "^CMAKE_(C|CXX)_FLAGS($|_)")
        list(APPEND jxrc_saved_flag_names "${name}")
        set(jxrc_saved_${name} "${${name}}")
    endif()
endforeach()
# Upstream caches the set of flags it has already appended. Reset that bookkeeping
# because the parent deliberately restores its flags after every configuration.
unset(AOM_C_FLAGS CACHE)
unset(AOM_CXX_FLAGS CACHE)
add_subdirectory("${libaom_SOURCE_DIR}" "${libaom_BINARY_DIR}" EXCLUDE_FROM_ALL)
foreach(name IN LISTS jxrc_saved_flag_names)
    if(NOT "${${name}}" STREQUAL "${jxrc_saved_${name}}")
        separate_arguments(before NATIVE_COMMAND "${jxrc_saved_${name}}")
        separate_arguments(after NATIVE_COMMAND "${${name}}")
        foreach(flag IN LISTS before)
            list(REMOVE_ITEM after "${flag}")
        endforeach()
        string(REGEX MATCH "^CMAKE_(C|CXX)_FLAGS(_(.*))?$" ignored "${name}")
        set(language "${CMAKE_MATCH_1}")
        set(config "${CMAKE_MATCH_3}")
        foreach(flag IN LISTS after)
            if(config)
                set(condition "$<AND:$<COMPILE_LANGUAGE:${language}>,$<CONFIG:${config}>>")
            else()
                set(condition "$<COMPILE_LANGUAGE:${language}>")
            endif()
            jxrc_aom_compile_option("${libaom_SOURCE_DIR}" "$<${condition}:${flag}>")
        endforeach()
        set(${name} "${jxrc_saved_${name}}" CACHE STRING "Compiler flags" FORCE)
    endif()
endforeach()
